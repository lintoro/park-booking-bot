# ==============================================================================
# 遊樂園團體預約 LINE 智慧自動化系統 - 環境變數範例檔 (.env.example)
# 部署至 Render 或本機運行時，請參考以下欄位設定
# ==============================================================================

# --- LINE Messaging API 金鑰 (LINE Developers Console 取得) ---
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# --- Google Gemini AI 智能客服 (Google AI Studio 取得: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Google 試算表資料庫設定 ---
# 試算表 ID (網址 /d/ 後方的一長串英數字元)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# 本機開發：服務帳戶金鑰檔案路徑
GOOGLE_CREDENTIALS_FILE=credentials.json

# Render 雲端部署推薦：直接將 service_account.json 的整份 JSON 字串貼於此變數
GOOGLE_CREDENTIALS_JSON=

# --- 伺服器與時區設定 ---
PORT=8000
TIMEZONE=Asia/Taipei
