{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#388E3C",
    "paddingAll": "20px",
    "contents": [
      {
        "type": "text",
        "text": "👥 選擇入園人數規模",
        "weight": "bold",
        "color": "#FFFFFF",
        "size": "xl"
      },
      {
        "type": "text",
        "text": "團體滿 20 人成團，可點選常用人數或直接打字",
        "color": "#E8F5E9",
        "size": "xs",
        "margin": "sm"
      }
    ]
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "paddingAll": "20px",
    "contents": [
      {
        "type": "text",
        "text": "🎫 票價計費標準",
        "weight": "bold",
        "size": "sm",
        "color": "#111111"
      },
      {
        "type": "box",
        "layout": "vertical",
        "margin": "sm",
        "spacing": "xs",
        "contents": [
          { "type": "text", "text": "▪ 全票 NT$ 280 / 半票 NT$ 140 / 幼童免費", "size": "xs", "color": "#555555" },
