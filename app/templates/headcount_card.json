      {
        "type": "separator",
        "margin": "md"
      },
      {
        "type": "box",
        "layout": "vertical",
        "spacing": "xs",
        "margin": "md",
        "contents": [
          {
            "type": "box",
            "layout": "horizontal",
            "spacing": "sm",
            "contents": [
              {
                "type": "button",
                "style": "secondary",
                "height": "sm",
                "action": {
                  "type": "message",
                  "label": "20人標準團",
                  "text": "全票20"
                }
              },
              {
                "type": "button",
                "style": "secondary",
                "height": "sm",
                "action": {
                  "type": "message",
                  "label": "30人歡樂團",
                  "text": "全票25 半票5"
                }
              }
            ]
          },
          {
            "type": "box",
            "layout": "horizontal",
            "spacing": "sm",
            "contents": [
              {
                "type": "button",
                "style": "secondary",
                "height": "sm",
                "action": {
                  "type": "message",
                  "label": "40人大型團",
                  "text": "全票30 半票10"
                }
              },
              {
                "type": "button",
                "style": "secondary",
                "height": "sm",
                "action": {
                  "type": "message",
                  "label": "50人旗艦團",
                  "text": "全票40 半票10"
                }
              }
            ]
          }
        ]
